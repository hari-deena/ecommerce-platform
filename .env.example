# Used by docker-compose.yml for the postgres and pgadmin containers.
# Copy to `.env` in this same directory: `cp .env.example .env`
# (docker compose auto-loads a `.env` file next to docker-compose.yml)

POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PGADMIN_EMAIL=admin@purelioraa.com
PGADMIN_PASSWORD=admin
