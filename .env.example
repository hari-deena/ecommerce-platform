# --- App ---
APP_NAME="Pure Lioraa API"
APP_ENV=local                # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Database ---
# NOTE: when running via `docker compose up`, docker-compose.yml overrides
# POSTGRES_HOST/PORT/DB/USER/PASSWORD with the `postgres` service's own values
# (from the root .env.example) — these are only used when running the backend
# directly on the host against `localhost:5432` (e.g. `make migrate` locally).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
DATABASE_POOL_SIZE=10

# --- Redis (cache / rate-limit / arq broker) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AWS / Bedrock ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- Email (password reset, order notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Pure Lioraa <no-reply@purelioraa.com>"

# --- Observability ---
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pure-lioraa-chatbot
